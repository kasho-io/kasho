# Copy this file to .env.local to run the demo app against a development environment:
#   cp .env.example .env.local
#
# Database connections - supports both PostgreSQL and MySQL
# PostgreSQL format: postgresql://user:password@host:port/database
# MySQL format: mysql://user:password@host:port/database

PRIMARY_DATABASE_URL=postgresql://kasho:kasho@localhost:5432/primary_db
REPLICA_DATABASE_URL=postgresql://kasho:kasho@localhost:5433/replica_db

# MySQL example:
# PRIMARY_DATABASE_URL=mysql://kasho:kasho@localhost:3306/primary_db
# REPLICA_DATABASE_URL=mysql://kasho:kasho@localhost:3307/replica_db
